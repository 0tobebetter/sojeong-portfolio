---
const name = "Sojeong Park";
const projectTitle = "Automation & Digital Workflow Transformation";
const role = "Data Analyst";
const context = "Marketing & Operations";

const summary =
  "Designed and implemented automated reporting and CRM workflows to reduce manual effort, minimise errors, and support faster decision-making.";

const problem = [
  "Recurring monthly and daily reports were handled manually across multiple spreadsheets.",
  "Processes took several days each month and ~30 minutes daily, with a high risk of human error.",
  "Non-technical team members frequently edited critical cells, causing data inconsistencies.",
];

const approach = [
  "Mapped existing workflows into smaller, repeatable units to identify automation opportunities.",
  "Connected multiple Google Sheets using structured formulas and controlled data flows.",
  "Implemented Apps Script automations for scheduled updates, validation, and alerts.",
  "Introduced access controls to protect critical ranges from accidental edits.",
];

const output = [
  "Automated reporting pipelines with scheduled refreshes",
  "Centralised CRM segmentation logic",
  "Real-time dashboards for stakeholders",
];

const impact = [
  "Reduced monthly reporting from 3–4 days to approximately 3 hours",
  "Cut daily operational updates from 30 minutes to 5 minutes",
  "Enabled leadership to make faster, data-informed decisions using reliable dashboards",
];

const tools = [
  "Google Sheets",
  "Google Apps Script",
  "Looker Studio",
  "Python",
  "APIs",
];

const nextSteps = [
  "Add automated data quality checks and logging",
  "Introduce version control for critical transformation logic",
  "Expand pipelines to support additional data sources",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{projectTitle} — {name}</title>
    <meta name="description" content={summary} />
    <style>
      main {
        max-width: 880px;
        margin: 0 auto;
        padding: 72px 20px;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      }
      h1 {
        font-size: 40px;
        margin-bottom: 8px;
        letter-spacing: -0.02em;
      }
      .meta {
        color: rgba(0, 0, 0, 0.65);
        margin-bottom: 32px;
      }
      h2 {
        margin-top: 40px;
        font-size: 20px;
        font-weight: 600;
      }
      p {
        line-height: 1.65;
        font-size: 16px;
      }
      ul {
        margin-top: 12px;
        padding-left: 18px;
      }
      li {
        margin-bottom: 6px;
        line-height: 1.6;
      }
      .box {
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 16px;
        padding: 18px;
        margin-top: 12px;
      }
      footer {
        margin-top: 64px;
        font-size: 14px;
        opacity: 0.6;
      }
      a {
        color: inherit;
      }
    </style>
  </head>

  <body>
    <main>
      <a href="/projects">← Back to Projects</a>

      <h1>{projectTitle}</h1>
      <p class="meta">
        {role} · {context}
      </p>

      <p>{summary}</p>

      <h2>Problem</h2>
      <div class="box">
        <ul>
          {problem.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <h2>Approach</h2>
      <div class="box">
        <ul>
          {approach.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <h2>Output</h2>
      <div class="box">
        <ul>
          {output.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <h2>Impact</h2>
      <div class="box">
        <ul>
          {impact.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <h2>Tools</h2>
      <div class="box">
        <ul>
          {tools.map((tool) => <li>{tool}</li>)}
        </ul>
      </div>

      <h2>What I’d Improve Next</h2>
      <div class="box">
        <ul>
          {nextSteps.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <footer>
        © {new Date().getFullYear()} {name}
      </footer>
    </main>
  </body>
</html>
