---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  site,
  social,
  skillCards,
  businessImpact,
  projects,
  experience,
} from "../data/site.js";
---

<BaseLayout title={`${site.name} — Portfolio`} description={site.tagline}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-top">
      <div>
        <h1>{site.name}</h1>
        <p class="role"><strong>{site.role}</strong></p>
        <p class="location">{site.location}</p>
      </div>

      <div class="social">
        {
          social.map((s) => (
            <a
              class="icon-btn"
              href={s.href}
              target="_blank"
              rel="noreferrer"
              aria-label={s.label}
              title={s.label}
            >
              {s.type === "linkedin" && (
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.11 1 2.48 1s2.5 1.12 2.5 2.5ZM.5 24h4V7.98h-4V24ZM8 7.98h3.83v2.19h.05c.53-1 1.83-2.19 3.77-2.19C19.5 7.98 21 10.27 21 14.6V24h-4v-8.31c0-1.98-.04-4.52-2.75-4.52-2.75 0-3.17 2.15-3.17 4.38V24H8V7.98Z" />
                </svg>
              )}

              {s.type === "github" && (
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12 .5C5.73.5.75 5.6.75 12c0 5.16 3.29 9.53 7.86 11.07.58.11.79-.26.79-.57v-2.1c-3.2.71-3.87-1.57-3.87-1.57-.52-1.36-1.27-1.72-1.27-1.72-1.04-.73.08-.72.08-.72 1.15.08 1.76 1.22 1.76 1.22 1.02 1.8 2.67 1.28 3.32.98.1-.76.4-1.28.72-1.57-2.55-.3-5.23-1.3-5.23-5.78 0-1.28.45-2.32 1.19-3.14-.12-.3-.52-1.52.11-3.16 0 0 .97-.32 3.18 1.2a10.7 10.7 0 0 1 5.79 0c2.2-1.52 3.18-1.2 3.18-1.2.63 1.64.23 2.86.11 3.16.74.82 1.19 1.86 1.19 3.14 0 4.49-2.69 5.48-5.25 5.78.41.37.78 1.1.78 2.23v3.31c0 .31.21.68.8.57A11.54 11.54 0 0 0 23.25 12C23.25 5.6 18.27.5 12 .5Z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <p class="tagline">{site.tagline}</p>
  </section>

  <!-- SKILLS -->
  <section>
    <h2>Key Skills</h2>
    <div class="grid">
      {
        skillCards.map((s) => (
          <div class="card">
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- BUSINESS IMPACT -->
  <section>
    <h2>Business Impact</h2>
    <ul>
      {businessImpact.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <!-- PROJECTS -->
  <section>
    <h2>Selected Projects</h2>
    <div class="grid">
      {
        projects.map((p) => (
          <a class="card link-card" href={p.href}>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
            <p class="muted">View case study →</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section>
    <h2>Work Experience</h2>
    <div class="stack">
      {
        experience.map((e) => (
          <div class="card">
            <h3>{e.title}</h3>
            <p class="muted">
              {e.org} · {e.period}
            </p>
            <ul>
              {e.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
